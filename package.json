    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "feed": "^6.0.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
